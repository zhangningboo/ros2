<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="galbot_one_golf">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import galbot_one_golf urdf file -->
    <xacro:include filename="$(find galbot_one_golf_description)/urdf/galbot_one_golf.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="galbot_one_golf.ros2_control.xacro" />


    <xacro:galbot_one_golf_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
